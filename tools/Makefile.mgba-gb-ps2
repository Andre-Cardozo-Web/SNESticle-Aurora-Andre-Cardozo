# AURORA_SGB_MGBA_STAGE_BUILD_V0_3_20260904
# AURORA_SGB_LCDC_TRACE_V0_6_7_20260905
# AURORA_SGB_SKIPBIOS_IO_TRACE_V0_6_6_20260905
# AURORA_SGB_SKIPBIOS_TRACE_V0_6_5_20260905
# AURORA_SGB_GBRESET_TRACE_V0_6_4_20260905
# AURORA_SGB_MGBA_CRC32_ALL_CALLERS_V0_5_8_20260904
# AURORA_SGB_MGBA_CRC32_NAMESPACE_V0_5_7_20260904
# AURORA_SGB_MGBA_DEAD_FRONTEND_PRUNE_V0_5_6_20260904
# AURORA_SGB_MGBA_MEMORY_ONLY_VFS_V0_5_5_20260904
# AURORA_SGB_MGBA_PRUNE_CONFIG_LOCALE_V0_5_4_20260904
ROOT       ?= $(abspath $(CURDIR))
MGBA_DIR   ?= $(ROOT)/src/third_party/mgba
BUILD_DIR  ?= $(ROOT)/build/mgba
STAGE_DIR  ?= $(ROOT)/build/mgba-src
OBJ_DIR    := $(BUILD_DIR)/obj
LIB        := $(BUILD_DIR)/libmgba_gb_ps2.a
STAGE_STAMP := $(STAGE_DIR)/.aurora-stage-v0_4
PREPARE    := $(ROOT)/tools/prepare_mgba_sgb_sources.py
PROBE_SRC  := $(ROOT)/tools/mgba_sgb_link_probe.c
PROBE_OBJ  := $(BUILD_DIR)/probe.o
PROBE_ELF  := $(BUILD_DIR)/mgba_sgb_link_probe.elf
PS2DEV ?= $(shell if [ -n "$$PREFIX" ]; then printf "%s/opt/ps2dev" "$$PREFIX"; else printf "%s/.local/ps2dev" "$$HOME"; fi)
ifeq ($(origin CC), default)
CC := $(shell if command -v ee-gcc >/dev/null 2>&1; then echo ee-gcc; elif command -v mips64r5900el-ps2-elf-gcc >/dev/null 2>&1; then echo mips64r5900el-ps2-elf-gcc; elif [ -x "$(PS2DEV)/ee/bin/ee-gcc" ]; then echo "$(PS2DEV)/ee/bin/ee-gcc"; elif [ -x "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-gcc" ]; then echo "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-gcc"; fi)
endif
ifeq ($(origin AR), default)
AR := $(shell if command -v ee-ar >/dev/null 2>&1; then echo ee-ar; elif command -v mips64r5900el-ps2-elf-ar >/dev/null 2>&1; then echo mips64r5900el-ps2-elf-ar; elif [ -x "$(PS2DEV)/ee/bin/ee-ar" ]; then echo "$(PS2DEV)/ee/bin/ee-ar"; elif [ -x "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ar" ]; then echo "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ar"; fi)
endif
ifeq ($(origin RANLIB), default)
RANLIB := $(shell if command -v ee-ranlib >/dev/null 2>&1; then echo ee-ranlib; elif command -v mips64r5900el-ps2-elf-ranlib >/dev/null 2>&1; then echo mips64r5900el-ps2-elf-ranlib; elif [ -x "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ranlib" ]; then echo "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ranlib"; else echo true; fi)
endif
PYTHON ?= python3
DEFS := -DMINIMAL_CORE=2 -DM_CORE_GB=1 -DDISABLE_THREADING=1 -DMGBA_STANDALONE=1 -DCOLOR_16_BIT=1 -DCOLOR_5_6_5=1
CFLAGS ?= -O2 -G0
CFLAGS += -std=gnu11 -ffunction-sections -fdata-sections -fno-strict-aliasing -Wno-unused-parameter -Wno-missing-field-initializers $(DEFS) -I$(STAGE_DIR)/include -I$(STAGE_DIR)/src
GB_SRC := src/gb/audio.c src/gb/gb.c src/gb/input.c src/gb/io.c src/gb/mbc.c src/gb/mbc/huc-3.c src/gb/mbc/licensed.c src/gb/mbc/mbc.c src/gb/mbc/pocket-cam.c src/gb/mbc/tama5.c src/gb/mbc/unlicensed.c src/gb/memory.c src/gb/serialize.c src/gb/sio.c src/gb/timer.c src/gb/video.c src/gb/renderers/software.c
SM83_SRC := src/sm83/decoder.c src/sm83/isa-sm83.c src/sm83/sm83.c
CORE_SRC := src/core/interface.c src/core/log.c src/core/timing.c
UTIL_SRC := src/util/audio-buffer.c src/util/circle-buffer.c src/util/crc32.c src/util/hash.c src/util/md5.c src/util/memory.c src/util/patch.c src/util/patch-fast.c src/util/patch-ips.c src/util/patch-ups.c src/util/ring-fifo.c src/util/sha1.c src/util/string.c src/util/table.c src/util/vector.c src/util/vfs.c src/util/vfs/vfs-mem.c
SRC := src/aurora-hooks.c $(GB_SRC) $(SM83_SRC) $(CORE_SRC) $(UTIL_SRC)
OBJ := $(addprefix $(OBJ_DIR)/,$(SRC:.c=.o))
.PHONY: all stage probe clean info
all: info $(LIB)
stage: $(STAGE_STAMP)
info:
	@echo "=== Aurora staged mGBA GBHost PS2 core ==="
	@echo "CC: $(CC)"
	@echo "PIN source: $(MGBA_DIR)"
	@echo "stage: $(STAGE_DIR)"
$(STAGE_STAMP): $(PREPARE)
	@rm -rf "$(STAGE_DIR)"
	@$(PYTHON) "$(PREPARE)" --source "$(MGBA_DIR)" --stage "$(STAGE_DIR)"
	@test -f "$@"
# AURORA_SGB_MGBA_STAGE_BUILD_V0_5_2_20260904
$(OBJ_DIR)/%.o: $(STAGE_STAMP)
	@mkdir -p "$(dir $@)"
	@test -f "$(STAGE_DIR)/$*.c" || { echo "ERRO: staged source ausente: $(STAGE_DIR)/$*.c"; exit 1; }
	@echo "[mGBA] CC $(STAGE_DIR)/$*.c"
	@$(CC) $(CFLAGS) -c "$(STAGE_DIR)/$*.c" -o "$@"
$(LIB): $(OBJ)
	@mkdir -p "$(dir $@)"
	@rm -f "$@"
	@$(AR) rcs "$@" $(OBJ)
	@$(RANLIB) "$@" >/dev/null 2>&1 || true
	@echo "OK: $@"
$(PROBE_OBJ): $(PROBE_SRC) $(STAGE_STAMP)
	@mkdir -p "$(dir $@)"
	@$(CC) $(CFLAGS) -c "$<" -o "$@"
$(PROBE_ELF): $(PROBE_OBJ) $(LIB)
	@$(CC) -G0 -Wl,--gc-sections -o "$@" $(PROBE_OBJ) $(LIB) -lm
	@echo "OK link probe: $@"
probe: $(PROBE_ELF)
clean:
	@rm -rf "$(BUILD_DIR)" "$(STAGE_DIR)"
