# AURORA_SGB_SAMEBOY_STAGE_BUILD_V1_20260906
ROOT        ?= $(abspath $(CURDIR))
SAMEBOY_DIR ?= $(ROOT)/src/third_party/sameboy
BUILD_DIR   ?= $(ROOT)/build/sameboy
STAGE_DIR   ?= $(ROOT)/build/sameboy-src
OBJ_DIR     := $(BUILD_DIR)/obj
LIB         := $(BUILD_DIR)/libsameboy_gb_ps2.a
STAGE_STAMP := $(STAGE_DIR)/.aurora-sameboy-stage-v1
PREPARE     := $(ROOT)/tools/prepare_sameboy_sgb_sources.py
COMPAT_SRC  := $(ROOT)/tools/sameboy_ps2_compat.c
COMPAT_HDR  := $(ROOT)/tools/sameboy_ps2_compat.h

PS2DEV ?= $(shell if [ -n "$$PREFIX" ]; then printf "%s/opt/ps2dev" "$$PREFIX"; else printf "%s/.local/ps2dev" "$$HOME"; fi)

ifeq ($(origin CC), default)
CC := $(shell if command -v ee-gcc >/dev/null 2>&1; then echo ee-gcc; elif command -v mips64r5900el-ps2-elf-gcc >/dev/null 2>&1; then echo mips64r5900el-ps2-elf-gcc; elif [ -x "$(PS2DEV)/ee/bin/ee-gcc" ]; then echo "$(PS2DEV)/ee/bin/ee-gcc"; elif [ -x "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-gcc" ]; then echo "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-gcc"; fi)
endif
ifeq ($(origin AR), default)
AR := $(shell if command -v ee-ar >/dev/null 2>&1; then echo ee-ar; elif command -v mips64r5900el-ps2-elf-ar >/dev/null 2>&1; then echo mips64r5900el-ps2-elf-ar; elif [ -x "$(PS2DEV)/ee/bin/ee-ar" ]; then echo "$(PS2DEV)/ee/bin/ee-ar"; elif [ -x "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ar" ]; then echo "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ar"; fi)
endif
ifeq ($(origin RANLIB), default)
RANLIB := $(shell if command -v ee-ranlib >/dev/null 2>&1; then echo ee-ranlib; elif command -v mips64r5900el-ps2-elf-ranlib >/dev/null 2>&1; then echo mips64r5900el-ps2-elf-ranlib; elif [ -x "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ranlib" ]; then echo "$(PS2DEV)/ee/bin/mips64r5900el-ps2-elf-ranlib"; else echo true; fi)
endif

PYTHON ?= python3

DEFS := \
	-D_GNU_SOURCE \
	-DGB_INTERNAL \
	-DGB_DISABLE_TIMEKEEPING \
	-DGB_DISABLE_REWIND \
	-DGB_DISABLE_DEBUGGER \
	-DGB_DISABLE_CHEATS \
	-DGB_DISABLE_CHEAT_SEARCH \
	-DNDEBUG \
	-Dvasprintf=aurora_sameboy_vasprintf \
	-Dasprintf=aurora_sameboy_asprintf

CFLAGS ?= -O3 -G0 -fomit-frame-pointer -finline-functions -ffast-math
CFLAGS += -std=gnu11 -ffunction-sections -fdata-sections -fno-strict-aliasing \
	-Wno-unused-parameter -Wno-missing-field-initializers -Wno-multichar $(DEFS) \
	-I$(STAGE_DIR)/Core -I$(ROOT)/tools -include $(COMPAT_HDR)

CORE_SRC := \
	Core/gb.c \
	Core/sgb.c \
	Core/apu.c \
	Core/memory.c \
	Core/mbc.c \
	Core/timing.c \
	Core/display.c \
	Core/camera.c \
	Core/sm83_cpu.c \
	Core/joypad.c \
	Core/save_state.c \
	Core/random.c \
	Core/rumble.c

OBJ := $(addprefix $(OBJ_DIR)/,$(CORE_SRC:.c=.o))
COMPAT_OBJ := $(OBJ_DIR)/aurora/sameboy_ps2_compat.o
CORE_DEPS := $(addprefix $(SAMEBOY_DIR)/Core/,$(notdir $(CORE_SRC)))

.PHONY: all stage clean info
all: info $(LIB)
stage: $(STAGE_STAMP)

info:
	@echo "=== Aurora staged SameBoy GBHost PS2 core ==="
	@echo "CC: $(CC)"
	@echo "PIN source: $(SAMEBOY_DIR)"
	@echo "stage: $(STAGE_DIR)"

$(STAGE_STAMP): $(PREPARE) $(CORE_DEPS)
	@rm -rf "$(STAGE_DIR)"
	@$(PYTHON) "$(PREPARE)" --source "$(SAMEBOY_DIR)" --stage "$(STAGE_DIR)"
	@test -f "$@"

$(OBJ_DIR)/Core/%.o: $(STAGE_STAMP) $(COMPAT_HDR)
	@mkdir -p "$(dir $@)"
	@echo "[SameBoy] CC $(STAGE_DIR)/Core/$*.c"
	@$(CC) $(CFLAGS) -c "$(STAGE_DIR)/Core/$*.c" -o "$@"

$(COMPAT_OBJ): $(COMPAT_SRC) $(COMPAT_HDR)
	@mkdir -p "$(dir $@)"
	@echo "[SameBoy] CC $(COMPAT_SRC)"
	@$(CC) $(CFLAGS) -c "$(COMPAT_SRC)" -o "$@"

$(LIB): $(OBJ) $(COMPAT_OBJ)
	@mkdir -p "$(dir $@)"
	@rm -f "$@"
	@$(AR) rcs "$@" $(OBJ) $(COMPAT_OBJ)
	@$(RANLIB) "$@" >/dev/null 2>&1 || true
	@echo "OK: $@"

clean:
	@rm -rf "$(BUILD_DIR)" "$(STAGE_DIR)"
